# Copy to .env and adjust. .env is gitignored; never commit real credentials.

# SQLite (default, no server needed):
# DATABASE_URL=sqlite:///D:/research project/newsAnalytics/data/news.db
# PostgreSQL (docker compose / own machine):
# DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news

# USER_AGENT=newsAnalytics/0.1 (+https://github.com/Nahid-Quader/newsAnalytics)
# PER_HOST_DELAY_S=2
# HTTP_MAX_RETRIES=3
# LOG_LEVEL=INFO
# LOG_JSON=true
# CORS_ORIGINS=["http://localhost:5173"]
